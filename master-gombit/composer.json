{
  "name": "master-gombit/secure-php-mysql-lab",
  "description": "Master Gombit: Acik kaynak, egitim amaclı, lokal PHP + MySQL güvenlik laboratuvasi (savunma odakli).",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.3",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-sodium": "*",
    "ext-json": "*",
    "ext-session": "*",
    "monolog/monolog": "^3.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^1.10",
    "symfony/var-dumper": "^7.0"
  },
  "autoload": {
    "psr-4": {
      "MG\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MG\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --colors=always",
    "stan": "phpstan analyse app --level=6",
    "audit": [
      "composer audit"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": false
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
