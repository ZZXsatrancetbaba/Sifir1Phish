# =============================================================================
# Master Gombit - ORTAM DEĞİŞKENLERİ ŞABLONU
# Kopyala: cp .env.example .env   (ve değerleri kendine göre doldur)
# !!! .env asla repoya commit edilmez (.gitignore'da). Gerçek secret girilmez.
# Buradaki tüm değerler SENTETİK / eğitim amaçlıdır.
# =============================================================================

# Uygulama
APP_NAME="Master Gombit"
APP_ENV=local                # local | staging-benzeri (lab) - prod önerilmez
APP_URL=http://127.0.0.1:8080
APP_DEBUG=false              # true SADECE lokalde ve feature flag ile anlam taşır
APP_KEY=                     # openssl rand -hex 32 ile üret, DOLDUR

# Veritabanı (yalnızca Docker iç ağı; host'a yayınlanmaz)
DB_HOST=db
DB_PORT=3306
DB_NAME=mg_lab
DB_USER=mg_user
DB_PASS=change-me-local-only         # sentetik; gerçek parola değil
DB_ROOT_PASS=change-me-root-local    # sentetik

# Oturum / Cookie
SESSION_NAME=MGBSID
SESSION_LIFETIME=1800
COOKIE_SECURE=false                  # HTTPS'e alınırsa true
COOKIE_SAMESITE=Lax                  # Lax | Strict

# Rate limit (login & flag submission)
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW=600          # saniye (10 dk) -> hesap kilidi süresi de
RATE_LIMIT_FLAG_ATTEMPTS=10
RATE_LIMIT_FLAG_WINDOW=300

# Feature Flags ---------------------------------------------------------------
# KASITLI ZAFİYETLİ EĞİTİM DEMOLARI: VARSAYILAN KAPALI.
# Açınca büyük uyarı banner'ı çıkar; yalnızca localhost/Docker içinde çalışır;
# içerikte yalnızca SAVUNMA odaklı anlatım + zararsız senematik karşılaştırma
# kodu bulunur, operasyonel saldırı aracı BULUNMAZ.
FEATURE_INSECURE_DEMOS=false
FEATURE_ADMIN_PANEL=false
FEATURE_FILE_UPLOAD_LAB=true
FEATURE_MFA_PLACEHOLDER=true

# Dosya yükleme lab'i
UPLOAD_MAX_BYTES=2097152             # 2 MB
UPLOAD_ALLOWED_EXT=png,jpg,gif,txt,pdf,md

# Audit / log
LOG_LEVEL=info                       # debug|info|warning|error
LOG_RETENTION_DAYS=30
AUDIT_IP_PEPPER=change-me-pepper     # IP hash için pepper (sentetik)
